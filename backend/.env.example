NODE_ENV=development
PORT=8001

DATABASE_URL=postgresql://tucancha:tucancha@localhost:5432/tucancha?schema=public

# Mínimo 32 caracteres — el backend aborta el arranque si es más corto.
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-chars
JWT_EXPIRES_IN=7d

# Lista explícita separada por coma. En producción NO se acepta "*" ni vacío.
# En desarrollo, si esta variable está vacía, el backend acepta por defecto
# http://localhost:3000, http://localhost:3001, http://127.0.0.1:3000 y :3001.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

PUBLIC_BASE_URL=http://localhost:8001

# Almacenamiento de comprobantes de pago: "local" o "s3".
STORAGE_DRIVER=local

# Driver local
UPLOADS_DIR=uploads

# Driver s3 (solo si STORAGE_DRIVER=s3)
S3_REGION=
S3_BUCKET=
S3_PREFIX=payment-proofs
# Opcional: base pública del bucket. Si se omite se arma la URL estándar de AWS.
S3_PUBLIC_BASE=
